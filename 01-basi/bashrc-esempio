# attenzione: prima e dopo il segno ‘=‘ non devono comparire spazi
# di solito in questo file ci sono le variabili d'ambiente e i miei alias

# --- alias di uso quotidiano ---
alias ll='ls -alFh'                     # lista dettagliata con dimensioni leggibili
