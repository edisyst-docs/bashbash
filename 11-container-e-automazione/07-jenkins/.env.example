# Facoltativo: copiare in .env per cambiare la password di admin (letta da compose.yaml e da agenti.sh)
# JENKINS_ADMIN_PASSWORD=admin

# I secret degli agenti: li scrive agenti.sh leggendoli dall'API di Jenkins
# (a mano: Manage Jenkins > Nodes > agentN, il valore dopo -secret)
AGENT1_SECRET=
AGENT2_SECRET=
AGENT3_SECRET=
